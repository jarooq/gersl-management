import sequelize from '../config/database.js';
import { QueryTypes } from 'sequelize';

// ============================================
// GET ALL ORPHAN NEEDS
// ============================================
export const getAllOrphanNeeds = async (req, res) => {
  try {
    const {
      orphanId,
      needCategory,
      urgency,
      status,
      page = 1,
      limit = 50
    } = req.query;

    // Build WHERE clause
    const conditions = [];
    const replacements = {};

    if (orphanId) {
      conditions.push('orphan_id = :orphanId');
      replacements.orphanId = orphanId;
    }

    if (needCategory) {
      conditions.push('need_category = :needCategory');
      replacements.needCategory = needCategory;
    }

    if (urgency) {
      conditions.push('urgency = :urgency');
      replacements.urgency = urgency;
    }

    if (status) {
      conditions.push('status = :status');
      replacements.status = status;
    }

    const whereClause = conditions.length > 0
      ? `WHERE ${conditions.join(' AND ')}`
      : '';

    // Calculate offset for pagination
    const offset = (page - 1) * limit;
    replacements.limit = parseInt(limit);
    replacements.offset = offset;

    // Get total count
    const countQuery = `
      SELECT COUNT(*) as total
      FROM orphan_needs
      ${whereClause}
    `;

    const [{ total }] = await sequelize.query(countQuery, {
      type: QueryTypes.SELECT,
      replacements
    });

    // Get paginated results with related data
    const query = `
      SELECT
        onn.*,
        o.full_name as orphan_name,
        o.district as orphan_district,
        u1.full_name as recorded_by_name,
        u2.full_name as approved_by_name
      FROM orphan_needs onn
      LEFT JOIN orphans o ON onn.orphan_id = o.id
      LEFT JOIN users u1 ON onn.recorded_by = u1.id
      LEFT JOIN users u2 ON onn.approved_by = u2.id
      ${whereClause}
      ORDER BY onn.recorded_date DESC, onn.created_at DESC
      LIMIT :limit OFFSET :offset
    `;

    const needs = await sequelize.query(query, {
      type: QueryTypes.SELECT,
      replacements
    });

    res.json({
      success: true,
      data: needs,
      pagination: {
        page: parseInt(page),
        limit: parseInt(limit),
        total: parseInt(total),
        totalPages: Math.ceil(total / limit)
      }
    });
  } catch (error) {
    console.error('Get all orphan needs error:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to fetch orphan needs',
      error: error.message
    });
  }
};

// ============================================
// GET ORPHAN NEED BY ID
// ============================================
export const getOrphanNeedById = async (req, res) => {
  try {
    const { id } = req.params;

    const query = `
      SELECT
        on.*,
        o.full_name as orphan_name,
        o.district as orphan_district,
        o.contact_number as orphan_contact,
        u1.full_name as recorded_by_name,
        u2.full_name as approved_by_name
      FROM orphan_needs on
      LEFT JOIN orphans o ON on.orphan_id = o.id
      LEFT JOIN users u1 ON on.recorded_by = u1.id
      LEFT JOIN users u2 ON on.approved_by = u2.id
      WHERE on.id = :id
    `;

    const [need] = await sequelize.query(query, {
      type: QueryTypes.SELECT,
      replacements: { id }
    });

    if (!need) {
      return res.status(404).json({
        success: false,
        message: 'Orphan need not found'
      });
    }

    res.json({
      success: true,
      data: need
    });
  } catch (error) {
    console.error('Get orphan need by ID error:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to fetch orphan need',
      error: error.message
    });
  }
};

// ============================================
// CREATE ORPHAN NEED
// ============================================
export const createOrphanNeed = async (req, res) => {
  try {
    const {
      orphanId,
      needType,
      needCategory,
      description,
      quantity = 1,
      estimatedCost,
      urgency = 'Medium',
      notes,
      visitId
    } = req.body;

    // Validation
    if (!orphanId || !needType || !req.user?.id) {
      return res.status(400).json({
        success: false,
        message: 'Missing required fields: orphanId, needType, or user authentication'
      });
    }

    const query = `
      INSERT INTO orphan_needs (
        orphan_id,
        need_type,
        need_category,
        description,
        quantity,
        estimated_cost,
        urgency,
        status,
        recorded_by,
        recorded_date,
        notes,
        visit_id,
        created_at,
        updated_at
      ) VALUES (
        :orphanId,
        :needType,
        :needCategory,
        :description,
        :quantity,
        :estimatedCost,
        :urgency,
        'Pending',
        :recordedBy,
        CURRENT_DATE,
        :notes,
        :visitId,
        CURRENT_TIMESTAMP,
        CURRENT_TIMESTAMP
      )
      RETURNING *
    `;

    const [newNeed] = await sequelize.query(query, {
      type: QueryTypes.INSERT,
      replacements: {
        orphanId,
        needType,
        needCategory: needCategory || 'Other',
        description: description || null,
        quantity,
        estimatedCost: estimatedCost || null,
        urgency,
        recordedBy: req.user.id,
        notes: notes || null,
        visitId: visitId || null
      }
    });

    res.status(201).json({
      success: true,
      message: 'Orphan need created successfully',
      data: newNeed
    });
  } catch (error) {
    console.error('Create orphan need error:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to create orphan need',
      error: error.message
    });
  }
};

// ============================================
// UPDATE ORPHAN NEED
// ============================================
export const updateOrphanNeed = async (req, res) => {
  try {
    const { id } = req.params;
    const {
      needType,
      needCategory,
      description,
      quantity,
      estimatedCost,
      urgency,
      status,
      notes,
      fulfilledBy,
      actualCost
    } = req.body;

    // Build UPDATE SET clause dynamically
    const updates = [];
    const replacements = { id };

    if (needType !== undefined) {
      updates.push('need_type = :needType');
      replacements.needType = needType;
    }
    if (needCategory !== undefined) {
      updates.push('need_category = :needCategory');
      replacements.needCategory = needCategory;
    }
    if (description !== undefined) {
      updates.push('description = :description');
      replacements.description = description;
    }
    if (quantity !== undefined) {
      updates.push('quantity = :quantity');
      replacements.quantity = quantity;
    }
    if (estimatedCost !== undefined) {
      updates.push('estimated_cost = :estimatedCost');
      replacements.estimatedCost = estimatedCost;
    }
    if (urgency !== undefined) {
      updates.push('urgency = :urgency');
      replacements.urgency = urgency;
    }
    if (status !== undefined) {
      updates.push('status = :status');
      replacements.status = status;

      // If status is Fulfilled, set fulfilled_date
      if (status === 'Fulfilled') {
        updates.push('fulfilled_date = CURRENT_DATE');
      }
    }
    if (notes !== undefined) {
      updates.push('notes = :notes');
      replacements.notes = notes;
    }
    if (fulfilledBy !== undefined) {
      updates.push('fulfilled_by = :fulfilledBy');
      replacements.fulfilledBy = fulfilledBy;
    }
    if (actualCost !== undefined) {
      updates.push('actual_cost = :actualCost');
      replacements.actualCost = actualCost;
    }

    if (updates.length === 0) {
      return res.status(400).json({
        success: false,
        message: 'No fields to update'
      });
    }

    updates.push('updated_at = CURRENT_TIMESTAMP');

    const query = `
      UPDATE orphan_needs
      SET ${updates.join(', ')}
      WHERE id = :id
      RETURNING *
    `;

    const [updatedNeed] = await sequelize.query(query, {
      type: QueryTypes.UPDATE,
      replacements
    });

    if (!updatedNeed || updatedNeed.length === 0) {
      return res.status(404).json({
        success: false,
        message: 'Orphan need not found'
      });
    }

    res.json({
      success: true,
      message: 'Orphan need updated successfully',
      data: updatedNeed[0]
    });
  } catch (error) {
    console.error('Update orphan need error:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to update orphan need',
      error: error.message
    });
  }
};

// ============================================
// APPROVE ORPHAN NEED
// ============================================
export const approveOrphanNeed = async (req, res) => {
  try {
    const { id } = req.params;
    const { approved } = req.body; // true or false

    if (approved === undefined) {
      return res.status(400).json({
        success: false,
        message: 'Missing required field: approved (true/false)'
      });
    }

    const query = `
      UPDATE orphan_needs
      SET
        status = :status,
        approved_by = :approvedBy,
        approved_date = CURRENT_DATE,
        updated_at = CURRENT_TIMESTAMP
      WHERE id = :id
      RETURNING *
    `;

    const [updatedNeed] = await sequelize.query(query, {
      type: QueryTypes.UPDATE,
      replacements: {
        id,
        status: approved ? 'Approved' : 'Cancelled',
        approvedBy: req.user.id
      }
    });

    if (!updatedNeed || updatedNeed.length === 0) {
      return res.status(404).json({
        success: false,
        message: 'Orphan need not found'
      });
    }

    res.json({
      success: true,
      message: `Orphan need ${approved ? 'approved' : 'rejected'} successfully`,
      data: updatedNeed[0]
    });
  } catch (error) {
    console.error('Approve orphan need error:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to approve/reject orphan need',
      error: error.message
    });
  }
};

// ============================================
// DELETE ORPHAN NEED
// ============================================
export const deleteOrphanNeed = async (req, res) => {
  try {
    const { id } = req.params;

    const query = `
      DELETE FROM orphan_needs
      WHERE id = :id
      RETURNING *
    `;

    const [deletedNeed] = await sequelize.query(query, {
      type: QueryTypes.DELETE,
      replacements: { id }
    });

    if (!deletedNeed || deletedNeed.length === 0) {
      return res.status(404).json({
        success: false,
        message: 'Orphan need not found'
      });
    }

    res.json({
      success: true,
      message: 'Orphan need deleted successfully',
      data: deletedNeed[0]
    });
  } catch (error) {
    console.error('Delete orphan need error:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to delete orphan need',
      error: error.message
    });
  }
};

// ============================================
// GET NEEDS SUMMARY/STATS
// ============================================
export const getNeedsSummary = async (req, res) => {
  try {
    const query = `
      SELECT
        COUNT(*) as total_needs,
        SUM(CASE WHEN status = 'Pending' THEN 1 ELSE 0 END) as pending_needs,
        SUM(CASE WHEN status = 'Approved' THEN 1 ELSE 0 END) as approved_needs,
        SUM(CASE WHEN status = 'Fulfilled' THEN 1 ELSE 0 END) as fulfilled_needs,
        SUM(CASE WHEN status = 'In Progress' THEN 1 ELSE 0 END) as in_progress_needs,
        SUM(CASE WHEN urgency = 'High' THEN 1 ELSE 0 END) as high_urgency_needs,
        SUM(COALESCE(estimated_cost, 0)) as total_estimated_cost,
        SUM(COALESCE(actual_cost, 0)) as total_actual_cost,
        need_category,
        COUNT(*) as category_count
      FROM orphan_needs
      GROUP BY need_category
    `;

    const summary = await sequelize.query(query, {
      type: QueryTypes.SELECT
    });

    // Also get overall summary (without grouping)
    const overallQuery = `
      SELECT
        COUNT(*) as total_needs,
        SUM(CASE WHEN status = 'Pending' THEN 1 ELSE 0 END) as pending_needs,
        SUM(CASE WHEN status = 'Approved' THEN 1 ELSE 0 END) as approved_needs,
        SUM(CASE WHEN status = 'Fulfilled' THEN 1 ELSE 0 END) as fulfilled_needs,
        SUM(CASE WHEN status = 'In Progress' THEN 1 ELSE 0 END) as in_progress_needs,
        SUM(CASE WHEN urgency = 'High' THEN 1 ELSE 0 END) as high_urgency_needs,
        SUM(COALESCE(estimated_cost, 0)) as total_estimated_cost,
        SUM(COALESCE(actual_cost, 0)) as total_actual_cost
      FROM orphan_needs
    `;

    const [overall] = await sequelize.query(overallQuery, {
      type: QueryTypes.SELECT
    });

    res.json({
      success: true,
      data: {
        overall,
        byCategory: summary
      }
    });
  } catch (error) {
    console.error('Get needs summary error:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to fetch needs summary',
      error: error.message
    });
  }
};
