# ============================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# Copy this file and fill in your production values
# DO NOT commit actual .env.production to git!

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=production
PORT=3001

# ============================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================
DB_USE_SQLITE=false
DB_DIALECT=postgres

# Railway auto-configures these - DO NOT SET MANUALLY:
# DB_HOST=<auto-configured>
# DB_PORT=<auto-configured>
# DB_NAME=<auto-configured>
# DB_USER=<auto-configured>
# DB_PASSWORD=<auto-configured>

# For custom PostgreSQL (Supabase, etc):
# DB_HOST=db.misihnasjvifnktfpylp.supabase.co
# DB_PORT=6543
# DB_NAME=postgres
# DB_USER=postgres.misihnasjvifnktfpylp
# DB_PASSWORD=<your-secure-password>

# Database sync - IMPORTANT!
# Set to true ONLY for first deployment, then change to false
ENABLE_DB_SYNC=false

# ============================================
# JWT CONFIGURATION
# ============================================
# CRITICAL: Generate new secure secrets for production
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=<GENERATE-SECURE-SECRET>
JWT_EXPIRE=24h
JWT_REFRESH_SECRET=<GENERATE-SECURE-REFRESH-SECRET>
JWT_REFRESH_EXPIRE=7d

# ============================================
# CORS CONFIGURATION
# ============================================
# Set to your exact frontend domain (NO trailing slash, NO wildcards)
CORS_ORIGIN=https://your-frontend.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# FILE UPLOAD
# ============================================
MAX_FILE_SIZE=5242880

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@gersl.org

# ============================================
# AI PROPOSAL ASSISTANT (Optional)
# ============================================
# Groq API Key (Primary - Fast, reliable, free)
GROQ_API_KEY=gsk_xxx

# Gemini API Key (Fallback)
GEMINI_API_KEY=AIzaxxx
