# ============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env when deploying to production
# Update all values with your production settings

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=production
PORT=3000

# ============================================
# DATABASE CONFIGURATION (PostgreSQL Recommended)
# ============================================
DB_USE_SQLITE=false
DB_HOST=your-production-db-host.com
DB_PORT=5432
DB_NAME=gersl_production
DB_USER=your_db_user
DB_PASSWORD=your_secure_db_password

# For PostgreSQL:
# Install: npm install pg pg-hstore
# Update database.js to use postgres dialect

# ============================================
# JWT CONFIGURATION (Generate new secrets!)
# ============================================
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_NEW_64_CHAR_SECRET
JWT_EXPIRE=24h
JWT_REFRESH_SECRET=REPLACE_WITH_NEW_64_CHAR_SECRET
JWT_REFRESH_EXPIRE=7d

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ORIGIN=https://your-production-domain.com

# ============================================
# RATE LIMITING (Adjust for production load)
# ============================================
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# FILE UPLOAD
# ============================================
MAX_FILE_SIZE=5242880

# ============================================
# EMAIL CONFIGURATION
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@gersl.org
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=GERSL System <noreply@gersl.org>

# ============================================
# FRONTEND URL
# ============================================
FRONTEND_URL=https://your-production-domain.com

# ============================================
# SECURITY (Optional but Recommended)
# ============================================
SESSION_SECRET=REPLACE_WITH_RANDOM_64_CHAR_STRING
BCRYPT_ROUNDS=12

# ============================================
# MONITORING & LOGGING (Optional)
# ============================================
SENTRY_DSN=your_sentry_dsn_here
LOG_LEVEL=error

# ============================================
# SSL/HTTPS (If using reverse proxy like Nginx)
# ============================================
TRUST_PROXY=true
