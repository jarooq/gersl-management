# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3001

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_USE_SQLITE=false
DB_DIALECT=postgres
DB_HOST=your-database-host.com
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_secure_database_password

# ============================================
# JWT CONFIGURATION
# ============================================
# Generate secure random secrets using:
# node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRE=24h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars
JWT_REFRESH_EXPIRE=7d

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ORIGIN=http://localhost:5173

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# FILE UPLOAD
# ============================================
MAX_FILE_SIZE=5242880

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@yourorganization.org

# ============================================
# FRONTEND URL
# ============================================
FRONTEND_URL=http://localhost:5173

# ============================================
# AI PROPOSAL ASSISTANT (Optional)
# ============================================
# Groq API Key (Primary - Recommended)
# Get your free API key from: https://console.groq.com/
# Free tier: 30 requests/minute, 14,400 requests/day
# Model: Llama 3 8B with JSON mode (guaranteed valid output)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Fallback - if Groq not configured)
# Get your free API key from: https://makersuite.google.com/app/apikey
# Free tier: 15 requests/minute, 1 million tokens/day
GEMINI_API_KEY=your_gemini_api_key_here
