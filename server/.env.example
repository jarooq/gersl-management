# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3001

# ============================================
# DATABASE CONFIGURATION (SUPABASE)
# ============================================
# Get these from: Supabase Dashboard → Settings → Database
# Use Pooler connection (port 6543) for better serverless compatibility
DB_DIALECT=postgres
DB_HOST=aws-X-XX-XXXX-X.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.your_project_ref
DB_PASSWORD=your_supabase_password
# Set to "false" to skip TLS cert verification in production (NOT recommended).
DB_SSL_STRICT=true

# Database sync - should be FALSE in production
# Tables are created via CREATE_ALL_TABLES.sql script
ENABLE_DB_SYNC=false

# ============================================
# JWT CONFIGURATION
# ============================================
# Generate secure random secrets using:
# node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRE=24h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars
JWT_REFRESH_EXPIRE=7d

# ============================================
# CORS CONFIGURATION
# ============================================
# Single origin (legacy)
CORS_ORIGIN=http://localhost:5173
# Comma-separated extra origins for prod (CloudFront, S3, Vercel, etc.)
# Example: https://erp-globalehsan.org,https://gersl-management.vercel.app
CORS_ALLOWED_ORIGINS=

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# FILE UPLOAD
# ============================================
MAX_FILE_SIZE=5242880

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
# For Microsoft 365: Use smtp.office365.com
# For Gmail: Use smtp.gmail.com (requires App Password)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your_email@yourdomain.com
SMTP_PASSWORD=your_password_here
EMAIL_FROM=noreply@yourorganization.org

# ============================================
# FRONTEND URL
# ============================================
FRONTEND_URL=http://localhost:5173

# ============================================
# AI PROPOSAL ASSISTANT (Optional)
# ============================================
# Groq API Key (Primary - Recommended)
# Get your free API key from: https://console.groq.com/
# Free tier: 30 requests/minute, 14,400 requests/day
# Model: Llama 3 8B with JSON mode (guaranteed valid output)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Fallback - if Groq not configured)
# Get your free API key from: https://makersuite.google.com/app/apikey
# Free tier: 15 requests/minute, 1 million tokens/day
GEMINI_API_KEY=your_gemini_api_key_here
