# Frontend Environment Variables Example
# Copy this file to .env and update the values

# API Configuration
VITE_API_BASE_URL=http://localhost:3000/api
VITE_API_TIMEOUT=30000

# For production, update to:
# VITE_API_BASE_URL=https://your-api-domain.com/api

# Google Analytics 4 Configuration
# Get your Measurement ID from Google Analytics: https://analytics.google.com/
# Format: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Enable analytics in development mode (optional, defaults to false)
# Set to 'true' to test analytics locally
VITE_ENABLE_ANALYTICS_DEV=false

# AI Proposal Assistant Configuration (Optional)
# Get your free Google Gemini API key from: https://makersuite.google.com/app/apikey
# This is stored in browser localStorage, not in environment variables
# Users will be prompted to enter their API key when using the AI Assistant for the first time
# Note: API key is stored locally in the browser and never sent to your server
