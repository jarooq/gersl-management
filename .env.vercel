# Vercel Environment Variables
# Copy these to Vercel Dashboard → Settings → Environment Variables
# Or use the commands below

# ============================================
# VERCEL CLI COMMANDS TO ADD THESE VARIABLES
# ============================================
# Run these commands one by one after running: npx vercel link

# Database Configuration
NODE_ENV=production
DB_USE_SQLITE=false
DB_DIALECT=postgres
DB_HOST=db.misihnasjvifnktfpylp.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=Ger@2025

# JWT Configuration
JWT_SECRET=WAwzcc0J/Q7ZI4VzhSjM/ilxZ6Q1J6dHhZ5BHSLxreg7Ef/jNg3gVzizgu8XzaLMPSQVZpuDrhQQJnSgyX3vPg==
JWT_EXPIRE=24h
JWT_REFRESH_SECRET=J2l3tAdj3vhEcyUdr61TjQH5WzrlPJ6kSOpPV8jeO+vwsu96HHfUTC+EGVsiS0+Srfd/RUtiHBuHkJKS2wLz+w==
JWT_REFRESH_EXPIRE=7d

# CORS Configuration (UPDATE WITH YOUR VERCEL URL!)
CORS_ORIGIN=https://gersl-management.vercel.app
FRONTEND_URL=https://gersl-management.vercel.app

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# CLI COMMANDS (Run these after getting your Vercel URL):
# ============================================
# npx vercel link
# echo "production" | npx vercel env add NODE_ENV production
# echo "false" | npx vercel env add DB_USE_SQLITE production
# echo "postgres" | npx vercel env add DB_DIALECT production
# echo "db.misihnasjvifnktfpylp.supabase.co" | npx vercel env add DB_HOST production
# echo "5432" | npx vercel env add DB_PORT production
# echo "postgres" | npx vercel env add DB_NAME production
# echo "postgres" | npx vercel env add DB_USER production
# echo "Ger@2025" | npx vercel env add DB_PASSWORD production
# echo "WAwzcc0J/Q7ZI4VzhSjM/ilxZ6Q1J6dHhZ5BHSLxreg7Ef/jNg3gVzizgu8XzaLMPSQVZpuDrhQQJnSgyX3vPg==" | npx vercel env add JWT_SECRET production
# echo "24h" | npx vercel env add JWT_EXPIRE production
