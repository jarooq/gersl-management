{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/((?!cron/).*)", "destination": "/api/index" },
    { "source": "/((?!assets/|.*\\.[a-zA-Z0-9]+$).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/cluster",     "schedule": "30 1 * * *" },
    { "path": "/api/cron/audit-prune", "schedule": "0 3 * * 0" }
  ],
  "env": { "VERCEL": "1" }
}
